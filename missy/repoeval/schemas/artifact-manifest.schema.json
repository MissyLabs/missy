{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repoeval-foundry:schema:artifact-manifest:v1",
  "title": "RepoEval Foundry artifact manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "run_id",
    "kind",
    "uri",
    "sha256",
    "size_bytes",
    "media_type",
    "producer",
    "classification",
    "retention_class",
    "scan_state",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_id": {"type": "string", "pattern": "^artifact-[a-zA-Z0-9_-]{8,128}$"},
    "run_id": {"type": "string", "pattern": "^run-[a-zA-Z0-9_-]{8,128}$"},
    "kind": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "uri": {"type": "string", "minLength": 1, "maxLength": 2048},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "media_type": {"type": "string", "minLength": 1, "maxLength": 255},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "classification": {"enum": ["public", "internal", "repository-sensitive", "restricted"]},
    "retention_class": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "redaction_state": {"enum": ["not-required", "pending", "complete", "failed"]},
    "scan_state": {"enum": ["pending", "clean", "quarantined", "failed"]},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
