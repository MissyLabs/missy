{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repoeval-foundry:schema:result:v1",
  "title": "RepoEval Foundry normalized result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "state", "provider", "timing", "validators", "artifact_ids", "recorded_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^run-[a-zA-Z0-9_-]{8,128}$", "readOnly": true},
    "state": {"enum": ["planned", "submitted", "running", "collecting", "verified", "failed", "cancelled"]},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_key", "requested_model"],
      "properties": {
        "registry_key": {"type": "string", "minLength": 1, "maxLength": 64},
        "requested_model": {"type": "string", "minLength": 1, "maxLength": 255},
        "actual_model": {"type": ["string", "null"], "maxLength": 255},
        "provider_request_id": {"type": ["string", "null"], "maxLength": 255}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_ms", "execution_ms", "total_ms"],
      "properties": {
        "queue_ms": {"type": "integer", "minimum": 0},
        "execution_ms": {"type": "integer", "minimum": 0},
        "provider_ms": {"type": ["integer", "null"], "minimum": 0},
        "total_ms": {"type": "integer", "minimum": 0}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "estimated_cost_microusd": {"type": ["integer", "null"], "minimum": 0},
        "pricing_snapshot": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "validators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "required", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "version": {"type": "string", "minLength": 1, "maxLength": 128},
          "required": {"type": "boolean"},
          "status": {"enum": ["passed", "failed", "error", "skipped"]},
          "score": {"type": ["number", "null"]},
          "exit_code": {"type": ["integer", "null"]},
          "evidence_artifact_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {"type": "number"}
    },
    "artifact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["category", "message", "retriable"],
      "properties": {
        "category": {"type": "string", "minLength": 1, "maxLength": 64},
        "message": {"type": "string", "maxLength": 2048},
        "retriable": {"type": "boolean"}
      }
    },
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
