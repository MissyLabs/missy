{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repoeval-foundry:schema:workload:v1",
  "title": "RepoEval Foundry workload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "repository",
    "task",
    "providers",
    "sandbox",
    "execution",
    "validation",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$", "readOnly": true},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "description": {"type": "string", "maxLength": 2048},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "commit_sha", "snapshot_id"],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1, "maxLength": 255, "readOnly": true},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$", "readOnly": true},
        "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 255, "readOnly": true},
        "subdirectory": {"type": "string", "maxLength": 1024}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "prompt_sha256"],
      "properties": {
        "class": {
          "enum": [
            "repository-orientation",
            "bug-localization",
            "patch-generation",
            "test-generation",
            "code-review",
            "tool-call",
            "documentation-drift",
            "custom"
          ]
        },
        "prompt_uri": {"type": "string", "minLength": 1, "maxLength": 2048},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fixture_digests": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "tool_schema_uris": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        }
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["registry_key", "model", "settings"],
        "properties": {
          "registry_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "model": {"type": "string", "minLength": 1, "maxLength": 255},
          "settings": {"type": "object"}
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_digest", "cpu_mhz", "memory_mb", "disk_mb", "network_policy"],
      "properties": {
        "image_digest": {"type": "string", "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"},
        "cpu_mhz": {"type": "integer", "minimum": 100, "maximum": 32000},
        "memory_mb": {"type": "integer", "minimum": 128, "maximum": 131072},
        "disk_mb": {"type": "integer", "minimum": 256, "maximum": 262144},
        "network_policy": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "architecture": {"enum": ["amd64", "arm64"]}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmups", "repetitions", "parallelism", "timeout_seconds", "max_attempts"],
      "properties": {
        "warmups": {"type": "integer", "minimum": 0, "maximum": 8},
        "repetitions": {"type": "integer", "minimum": 1, "maximum": 32},
        "parallelism": {"type": "integer", "minimum": 1, "maximum": 8},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 3},
        "seed": {"type": "integer"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator_version", "validators"],
      "properties": {
        "evaluator_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "validators": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "required"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
              "version": {"type": "string", "minLength": 1, "maxLength": 128},
              "required": {"type": "boolean"},
              "parameters": {"type": "object"}
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_prefix", "retention_class", "required_kinds"],
      "properties": {
        "output_prefix": {"type": "string", "minLength": 1, "maxLength": 1024},
        "retention_class": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "required_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}
        }
      }
    }
  }
}
