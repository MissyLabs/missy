[Unit]
Description=Missy native Rust gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=missy-native
Group=missy-native
WorkingDirectory=/var/lib/missy-native
EnvironmentFile=/etc/missy-native/environment
ExecStartPre=/opt/missy-native/current/missy-rs --config /etc/missy-native/config.yaml config-check
ExecStart=/opt/missy-native/current/missy-rs --config /etc/missy-native/config.yaml gateway start
ExecReload=/opt/missy-native/current/missy-rs --config /etc/missy-native/config.yaml gateway check-reload
Restart=on-failure
RestartSec=10
TimeoutStartSec=620
TimeoutStopSec=320
KillSignal=SIGTERM
KillMode=control-group
UMask=0077
StateDirectory=missy-native
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
# No PrivateDevices/PrivateTmp/ProtectHome/MemoryDenyWriteExecute:
# those break opt-in audio, X11/CDP, model runtimes or extension roots.
# Dedicated account only, never the active desktop user.

[Install]
WantedBy=multi-user.target
